{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "public"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/super-admin",
      "destination": "/super-admin/index.html"
    },
    {
      "source": "/super-admin/(.*)",
      "destination": "/super-admin/index.html"
    },
    {
      "source": "/((?!api|admin|super-admin).*)" ,
      "destination": "/index.html"
    }
  ]
}
